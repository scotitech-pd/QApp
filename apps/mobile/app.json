{
  "expo": {
    "name": "OnQ",
    "slug": "q-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101828"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scotitech.qapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101828"
      },
      "package": "com.scotitech.qapp",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "OnQ uses the camera to scan a shop's QR code so you can join its queue."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": [
      "onq",
      "com.googleusercontent.apps.216837184187-q7v35ru832dnb9rqbcn051ef93lva51t"
    ],
    "extra": {
      "googleClientIds": {
        "iosClientId": "216837184187-q7v35ru832dnb9rqbcn051ef93lva51t.apps.googleusercontent.com",
        "androidClientId": "216837184187-i2jvt542dcb2gh570an42ngc6n8sdj85.apps.googleusercontent.com",
        "webClientId": "216837184187-s5hiouu90lqompuk38cpses0ehoqdkcd.apps.googleusercontent.com"
      }
    }
  }
}
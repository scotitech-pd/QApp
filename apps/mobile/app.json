{
  "expo": {
    "name": "OnQ",
    "slug": "q-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101828"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scotitech.qapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101828"
      },
      "package": "com.scotitech.qapp",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "OnQ uses the camera to scan a shop's QR code so you can join its queue."
        }
      ],
      "expo-web-browser"
    ]
  }
}

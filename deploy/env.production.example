# /srv/onq/app/.env — production environment for onq.scotitech.com
# Copy to /srv/onq/app/.env and fill every <...> before first deploy.

NODE_ENV="production"
HOST="127.0.0.1"          # only Caddy talks to the apps directly
PORT="4000"

# ---- Database (local PostgreSQL on this server) ----
# Generate the password once: openssl rand -hex 24
# Both URLs are identical for a local database (DIRECT_URL exists for
# pooler setups; Prisma requires the variable either way).
DATABASE_URL="postgresql://onq:<DB-PASSWORD>@127.0.0.1:5432/onq"
DIRECT_URL="postgresql://onq:<DB-PASSWORD>@127.0.0.1:5432/onq"

# ---- URLs ----
APP_BASE_URL="https://onq.scotitech.com"
NEXT_PUBLIC_API_BASE_URL="https://onq.scotitech.com"

# ---- Security ----
# Generate: openssl rand -hex 48   (do NOT reuse the dev value)
AUTH_ACCESS_TOKEN_SECRET="<generate-with-openssl-rand-hex-48>"
AUTH_ACCESS_TOKEN_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_DAYS="30"
AUTH_PASSWORD_RESET_TTL_MINUTES="30"
AUTH_PASSWORD_MIN_LENGTH="10"
AUTH_LOGIN_MAX_FAILED_ATTEMPTS="5"
AUTH_LOGIN_LOCKOUT_MINUTES="15"

# Browsers only (native apps ignore CORS). Same-origin web needs no extra
# entries; add the Vercel URL here only if you keep it running.
CORS_ALLOWED_ORIGINS="https://onq.scotitech.com"

# ---- Pilot mode ----
# true = OTP is returned in the API response and shown on screen (no SMS cost).
# Switch to false only when an SMS provider below is configured.
PILOT_MODE="true"

# ---- Customer sign-in ----
APPLE_CLIENT_ID="com.scotitech.qapp"
GOOGLE_OAUTH_CLIENT_IDS="216837184187-q7v35ru832dnb9rqbcn051ef93lva51t.apps.googleusercontent.com,216837184187-i2jvt542dcb2gh570an42ngc6n8sdj85.apps.googleusercontent.com,216837184187-s5hiouu90lqompuk38cpses0ehoqdkcd.apps.googleusercontent.com"

# ---- Web push (QR/no-app path) ----
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<vapid-public>"
VAPID_PRIVATE_KEY="<vapid-private>"
VAPID_SUBJECT="mailto:hello@scotitech.com"

# ---- SMS providers (leave empty during pilot) ----
NOTIFY_SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# ---- Maps (optional; distance works without it) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# ---- Transactional email (Hostinger mailbox, shared with appdeploy) ----
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@scotitech.com"
SMTP_PASSWORD="<copy from appdeploy container env: EMAIL_PASSWORD>"
SMTP_FROM_NAME="OnQ"
ADMIN_NOTIFY_EMAIL="info@scotitech.com"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appq"
HOST="0.0.0.0"
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
AUTH_ACCESS_TOKEN_SECRET="change-me"
AUTH_ACCESS_TOKEN_TTL_SECONDS="900"
AUTH_REFRESH_TOKEN_TTL_DAYS="30"
AUTH_PASSWORD_RESET_TTL_MINUTES="30"
AUTH_PASSWORD_MIN_LENGTH="10"
AUTH_LOGIN_MAX_FAILED_ATTEMPTS="5"
AUTH_LOGIN_LOCKOUT_MINUTES="15"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
# Pilot mode: when true, the OTP is returned in the queue/join/start response
# and shown on the customer's screen instead of being sent by SMS. Use this for
# free market-validation pilots with a friendly shop. Set to false and provide
# Twilio credentials below to switch to real SMS.
PILOT_MODE="true"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
STRIPE_SECRET_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Notification providers (Sprint 4) ---
# SMS: leave NOTIFY_SMS_PROVIDER empty to auto-detect (twilio → msg91 → preview).
NOTIFY_SMS_PROVIDER=""
# MSG91 (India, needs DLT-registered template)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""
# WhatsApp Business Cloud API (tried first for queue alerts when set)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"
# Web Push (generate with: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@onq.app"
# Customer accounts (Sign in with Apple / Google)
APPLE_CLIENT_ID="com.scotitech.qapp"
GOOGLE_OAUTH_CLIENT_IDS="<ios-id>,<android-id>,<web-id>"
# Deep links (Universal/App Links) — set once you own a domain
ONQ_PUBLIC_DOMAIN=""
ANDROID_SHA256_FINGERPRINTS=""

# --- Transactional email (password resets, admin notifications) ---
# Leave empty in dev: reset links show on screen instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="OnQ"
ADMIN_NOTIFY_EMAIL=""
